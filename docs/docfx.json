{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "files": [ "src/**/*.csproj" ],
          "src": ".."
        }
      ],
      "dest": "api",
      "includePrivateMembers": false,
      "disableGitFeatures": false,
      "disableDefaultFilter": false,
      "allowCompilationErrors": false,
      "properties": {
        "TargetFramework": "net10.0-windows"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [ "**/*.{md,yml}" ],
        "exclude": [ "_site/**", "obj/**" ]
      }
    ],
    "resource": [
      {
        "files": [ "images/**" ],
        "exclude": [ "_site/**", "obj/**" ]
      }
    ],
    "output": "_site",
    "template": [ "default", "modern" ],
    "globalMetadata": {
      "_appName": "Flawright",
      "_appTitle": "Flawright — Playwright-style desktop UI automation for .NET",
      "_appFooter": "Flawright — MIT License",
      "_description": "Playwright-flavored async API for FlaUI Windows desktop application automation and E2E testing.",
      "_copyright": "Copyright © 2026 Jerrett Davis. Licensed under the MIT License.",
      "_enableSearch": true,
      "_disableContribution": false,
      "_gitContribute": {
        "repo": "https://github.com/JerrettDavis/Flawright",
        "branch": "main"
      }
    }
  }
}

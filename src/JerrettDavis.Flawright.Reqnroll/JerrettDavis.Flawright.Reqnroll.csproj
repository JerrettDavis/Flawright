<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>JerrettDavis.Flawright.Reqnroll</RootNamespace>
    <PackageId>Flawright.Reqnroll</PackageId>
    <Description>Reqnroll (BDD/Gherkin) step bindings and DI wiring for Flawright Windows desktop UI automation.</Description>
    <PackageTags>flawright;reqnroll;bdd;gherkin;ui-automation;windows;desktop;specflow</PackageTags>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>CS1591</WarningsAsErrors>
    <PackageReleaseNotes>See https://github.com/JerrettDavis/Flawright/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\JerrettDavis.Flawright\JerrettDavis.Flawright.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- BoDi (IObjectContainer) is a transitive dependency of Reqnroll — no separate reference needed -->
    <PackageReference Include="Reqnroll" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Condition="Exists('..\..\README.md')" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" Condition="Exists('..\..\LICENSE')" />
  </ItemGroup>

</Project>

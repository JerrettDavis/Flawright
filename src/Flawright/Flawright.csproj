<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Flawright</RootNamespace>
    <PackageId>Flawright</PackageId>
    <Description>Playwright-style async API for FlaUI Windows desktop application automation and E2E testing.</Description>
    <PackageTags>flaui;ui-automation;playwright;windows;testing;automation;desktop</PackageTags>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>CS1591</WarningsAsErrors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReleaseNotes>See https://github.com/JerrettDavis/Flawright/blob/main/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.Core" />
    <PackageReference Include="FlaUI.UIA3" />
    <!-- Explicit transitive override: FlaUI pulls in vulnerable System.Drawing.Common 5.0.2 -->
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>

  <ItemGroup>
    <!-- Expose internals (SelectorParser, KeyParser, AutoWait) to the unit test project -->
    <InternalsVisibleTo Include="Flawright.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Condition="Exists('..\..\README.md')" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" Condition="Exists('..\..\LICENSE')" />
  </ItemGroup>

</Project>

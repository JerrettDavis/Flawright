<Window x:Class="Flawright.E2ETests.TestApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flawright Test App"
        AutomationProperties.AutomationId="MainWindow"
        AutomationProperties.Name="Flawright Test App"
        Width="480"
        Height="600"
        ResizeMode="CanResize">

    <StackPanel Margin="16" VerticalAlignment="Top">

        <!-- ── Click ─────────────────────────────────────────────────────────── -->
        <Button x:Name="btnClick"
                Content="Click Me"
                AutomationProperties.AutomationId="btnClick"
                AutomationProperties.Name="Click Me"
                Height="32"
                Margin="0,0,0,8"
                Click="BtnClick_Click" />

        <!-- ── Double-click ───────────────────────────────────────────────────── -->
        <Button x:Name="btnDoubleClick"
                Content="Double Click"
                AutomationProperties.AutomationId="btnDoubleClick"
                AutomationProperties.Name="Double Click"
                Height="32"
                Margin="0,0,0,8"
                MouseDoubleClick="BtnDoubleClick_MouseDoubleClick" />

        <!-- ── FillAsync target ───────────────────────────────────────────────── -->
        <TextBox x:Name="txtFill"
                 AutomationProperties.AutomationId="txtFill"
                 AutomationProperties.Name="txtFill"
                 Height="28"
                 Margin="0,0,0,8" />

        <!-- ── TypeAsync target ───────────────────────────────────────────────── -->
        <TextBox x:Name="txtType"
                 AutomationProperties.AutomationId="txtType"
                 AutomationProperties.Name="txtType"
                 Height="28"
                 Margin="0,0,0,8" />

        <!-- ── CheckAsync / UncheckAsync ─────────────────────────────────────── -->
        <CheckBox x:Name="chkToggle"
                  Content="Toggle me"
                  AutomationProperties.AutomationId="chkToggle"
                  AutomationProperties.Name="Toggle me"
                  Margin="0,0,0,8" />

        <!-- ── SelectOptionAsync ──────────────────────────────────────────────── -->
        <ComboBox x:Name="cmbSelect"
                  AutomationProperties.AutomationId="cmbSelect"
                  AutomationProperties.Name="cmbSelect"
                  Height="28"
                  Margin="0,0,0,8">
            <ComboBoxItem Content="Option A" AutomationProperties.Name="Option A" />
            <ComboBoxItem Content="Option B" AutomationProperties.Name="Option B" />
            <ComboBoxItem Content="Option C" AutomationProperties.Name="Option C" />
        </ComboBox>

        <!-- ── Filter (ListBox) ──────────────────────────────────────────────── -->
        <ListBox x:Name="lstFilter"
                 AutomationProperties.AutomationId="lstFilter"
                 AutomationProperties.Name="lstFilter"
                 Height="80"
                 Margin="0,0,0,8">
            <ListBoxItem Content="Apple"     AutomationProperties.Name="Apple" />
            <ListBoxItem Content="Banana"    AutomationProperties.Name="Banana" />
            <ListBoxItem Content="Cherry"    AutomationProperties.Name="Cherry" />
            <ListBoxItem Content="Apple Pie" AutomationProperties.Name="Apple Pie" />
        </ListBox>

        <!-- ── RadioButtons ──────────────────────────────────────────────────── -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <RadioButton x:Name="radio1"
                         Content="Radio 1"
                         GroupName="TestRadios"
                         AutomationProperties.AutomationId="radio1"
                         AutomationProperties.Name="Radio 1"
                         Margin="0,0,16,0" />
            <RadioButton x:Name="radio2"
                         Content="Radio 2"
                         GroupName="TestRadios"
                         AutomationProperties.AutomationId="radio2"
                         AutomationProperties.Name="Radio 2" />
        </StackPanel>

        <!-- ── Output label ──────────────────────────────────────────────────── -->
        <!--
            TextBox with IsReadOnly="True" is used instead of TextBlock so that
            UIA exposes the content via ValuePattern.Value, which refreshes on every
            Text mutation. TextBlock only exposes its initial text via the UIA Name
            property (set at element-load time from AutomationProperties.Name) and
            does not update when Text changes programmatically.
        -->
        <TextBox x:Name="lblOutput"
                 AutomationProperties.AutomationId="lblOutput"
                 AutomationProperties.Name="lblOutput"
                 IsReadOnly="True"
                 IsTabStop="False"
                 BorderThickness="0"
                 Background="Transparent"
                 Text=""
                 Height="24"
                 Margin="0,0,0,8" />

        <!-- ── Show Dialog ───────────────────────────────────────────────────── -->
        <Button x:Name="btnShowDialog"
                Content="Show Dialog"
                AutomationProperties.AutomationId="btnShowDialog"
                AutomationProperties.Name="Show Dialog"
                Height="32"
                Margin="0,0,0,8"
                Click="BtnShowDialog_Click" />

        <!-- ── Spawn Window (multi-window E2E target) ────────────────────────── -->
        <Button x:Name="btnSpawnWindow"
                Content="Spawn Window"
                AutomationProperties.AutomationId="btnSpawnWindow"
                AutomationProperties.Name="Spawn Window"
                Height="32"
                Margin="0,0,0,8"
                Click="BtnSpawnWindow_Click" />

        <!--
            Nested control hierarchy used by LocatorChainTests.
            Three levels of UIA-visible nesting (outer GroupBox → inner GroupBox
            → Buttons) so multi-level Locator(...).Locator(...).Locator(...)
            chains can be exercised. WPF's panels (StackPanel, Grid) do not
            appear in the UIA tree by default, so we use nested GroupBoxes
            which always do.

            Button names follow a regular pattern so HasTextRegex and
            HasNotTextRegex filters can be validated deterministically.
        -->
        <GroupBox x:Name="nestedGroup"
                  Header="Nested"
                  AutomationProperties.AutomationId="nestedGroup"
                  AutomationProperties.Name="nestedGroup"
                  Margin="0,0,0,8">
            <GroupBox x:Name="innerGroup"
                      Header="Inner"
                      AutomationProperties.AutomationId="innerGroup"
                      AutomationProperties.Name="innerGroup">
                <StackPanel Orientation="Vertical">
                    <Button x:Name="btnInnerAlpha1"
                            Content="Inner Alpha 1"
                            AutomationProperties.AutomationId="btnInnerAlpha1"
                            AutomationProperties.Name="Inner Alpha 1"
                            Height="24"
                            Margin="0,0,0,4" />
                    <Button x:Name="btnInnerAlpha2"
                            Content="Inner Alpha 2"
                            AutomationProperties.AutomationId="btnInnerAlpha2"
                            AutomationProperties.Name="Inner Alpha 2"
                            Height="24"
                            Margin="0,0,0,4" />
                    <Button x:Name="btnInnerBeta1"
                            Content="Inner Beta 1"
                            AutomationProperties.AutomationId="btnInnerBeta1"
                            AutomationProperties.Name="Inner Beta 1"
                            Height="24" />
                </StackPanel>
            </GroupBox>
        </GroupBox>

        <!-- ── Cross-framework window-type buttons ────────────────────────────── -->

        <Button x:Name="btnShowDialogNoOwner"
                Content="Show Dialog (No Owner)"
                AutomationProperties.AutomationId="btnShowDialogNoOwner"
                AutomationProperties.Name="Show Dialog (No Owner)"
                Height="32"
                Margin="0,0,0,2"
                Click="BtnShowDialogNoOwner_Click" />

        <Button x:Name="btnShowModelessOwned"
                Content="Show Modeless Owned"
                AutomationProperties.AutomationId="btnShowModelessOwned"
                AutomationProperties.Name="Show Modeless Owned"
                Height="32"
                Margin="0,0,0,2"
                Click="BtnShowModelessOwned_Click" />

        <Button x:Name="btnShowToolWindow"
                Content="Show Tool Window"
                AutomationProperties.AutomationId="btnShowToolWindow"
                AutomationProperties.Name="Show Tool Window"
                Height="32"
                Margin="0,0,0,2"
                Click="BtnShowToolWindow_Click" />

        <Button x:Name="btnShowNestedDialog"
                Content="Show Nested Dialog"
                AutomationProperties.AutomationId="btnShowNestedDialog"
                AutomationProperties.Name="Show Nested Dialog"
                Height="32"
                Margin="0,0,0,2"
                Click="BtnShowNestedDialog_Click" />

        <Button x:Name="btnShowWinFormsModal"
                Content="Show WinForms Modal"
                AutomationProperties.AutomationId="btnShowWinFormsModal"
                AutomationProperties.Name="Show WinForms Modal"
                Height="32"
                Margin="0,0,0,2"
                Click="BtnShowWinFormsModal_Click" />

        <Button x:Name="btnShowWinFormsModeless"
                Content="Show WinForms Modeless"
                AutomationProperties.AutomationId="btnShowWinFormsModeless"
                AutomationProperties.Name="Show WinForms Modeless"
                Height="32"
                Margin="0,0,0,2"
                Click="BtnShowWinFormsModeless_Click" />

        <Button x:Name="btnShowMessageBox"
                Content="Show MessageBox"
                AutomationProperties.AutomationId="btnShowMessageBox"
                AutomationProperties.Name="Show MessageBox"
                Height="32"
                Margin="0,0,0,2"
                Click="BtnShowMessageBox_Click" />

        <Button x:Name="btnShowOpenFileDialog"
                Content="Show OpenFileDialog"
                AutomationProperties.AutomationId="btnShowOpenFileDialog"
                AutomationProperties.Name="Show OpenFileDialog"
                Height="32"
                Margin="0,0,0,2"
                Click="BtnShowOpenFileDialog_Click" />

        <!-- ── Exit ──────────────────────────────────────────────────────────── -->
        <Button x:Name="btnExit"
                Content="Exit"
                AutomationProperties.AutomationId="btnExit"
                AutomationProperties.Name="Exit"
                Height="32"
                Click="BtnExit_Click" />

        <!-- ── Wave A additional controls ────────────────────────────────────── -->
        <TabControl x:Name="tabAdditionalControls"
                    AutomationProperties.AutomationId="tabAdditionalControls"
                    AutomationProperties.Name="Additional Controls"
                    Margin="0,8,0,0"
                    Height="320">

            <!-- Tab: Inputs -->
            <TabItem Header="Inputs"
                     AutomationProperties.AutomationId="tabInputs"
                     AutomationProperties.Name="Inputs">
                <StackPanel Margin="8">

                    <!-- Multi-line TextBox -->
                    <TextBox x:Name="txtMultiline"
                             AutomationProperties.AutomationId="txtMultiline"
                             AutomationProperties.Name="txtMultiline"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             Height="60"
                             Margin="0,0,0,4"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />

                    <!-- PasswordBox -->
                    <PasswordBox x:Name="pwdPassword"
                                 AutomationProperties.AutomationId="pwdPassword"
                                 AutomationProperties.Name="pwdPassword"
                                 Height="24"
                                 Margin="0,0,0,4" />

                    <!-- Editable ComboBox -->
                    <ComboBox x:Name="cboEditable"
                              AutomationProperties.AutomationId="cboEditable"
                              AutomationProperties.Name="cboEditable"
                              IsEditable="True"
                              Height="24"
                              Margin="0,0,0,4">
                        <ComboBoxItem Content="Alpha" AutomationProperties.Name="Alpha" />
                        <ComboBoxItem Content="Beta"  AutomationProperties.Name="Beta"  />
                    </ComboBox>

                    <!-- TextBox with placeholder (HelpText used by GetByPlaceholder) -->
                    <TextBox x:Name="txtPlaceholderTest"
                             AutomationProperties.AutomationId="txtPlaceholderTest"
                             AutomationProperties.Name="txtPlaceholderTest"
                             AutomationProperties.HelpText="Enter your name"
                             Height="24"
                             Margin="0,0,0,4" />

                    <!-- Label + TextBox pair for GetByLabel -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Label x:Name="lblLabeledField"
                               AutomationProperties.AutomationId="lblLabeledField"
                               Content="Email:"
                               Target="{Binding ElementName=txtLabeledField}"
                               VerticalAlignment="Center"
                               Width="60" />
                        <TextBox x:Name="txtLabeledField"
                                 AutomationProperties.AutomationId="txtLabeledField"
                                 AutomationProperties.Name="txtLabeledField"
                                 Height="24"
                                 Width="120" />
                    </StackPanel>

                    <!-- GetByTestId target -->
                    <TextBox AutomationProperties.AutomationId="test-id-target"
                             AutomationProperties.Name="test-id-target"
                             AutomationProperties.HelpText="TestId target"
                             Height="24" />

                </StackPanel>
            </TabItem>

            <!-- Tab: Selection -->
            <TabItem Header="Selection"
                     AutomationProperties.AutomationId="tabSelection"
                     AutomationProperties.Name="Selection">
                <StackPanel Margin="8">

                    <!-- Slider (RangeValuePattern) -->
                    <Slider x:Name="sliderVolume"
                            AutomationProperties.AutomationId="sliderVolume"
                            AutomationProperties.Name="sliderVolume"
                            Minimum="0"
                            Maximum="100"
                            Value="50"
                            Height="24"
                            Margin="0,0,0,4" />

                    <!-- Scrollable ListBox with 50 items (populated in code-behind) -->
                    <ListBox x:Name="lsbScrollable"
                             AutomationProperties.AutomationId="lsbScrollable"
                             AutomationProperties.Name="lsbScrollable"
                             Height="80"
                             Margin="0,0,0,4" />

                    <!-- ListView with columns (populated in code-behind) -->
                    <ListView x:Name="lvData"
                              AutomationProperties.AutomationId="lvData"
                              AutomationProperties.Name="lvData"
                              Height="80"
                              Margin="0,0,0,4">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name"   DisplayMemberBinding="{Binding Name}"   Width="80" />
                                <GridViewColumn Header="Value"  DisplayMemberBinding="{Binding Value}"  Width="60" />
                                <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="70" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- TreeView with hierarchy -->
                    <TreeView x:Name="tvHierarchy"
                              AutomationProperties.AutomationId="tvHierarchy"
                              AutomationProperties.Name="tvHierarchy"
                              Height="80"
                              Margin="0,0,0,4">
                        <TreeViewItem Header="Root 1" AutomationProperties.AutomationId="tvRoot1" AutomationProperties.Name="Root 1">
                            <TreeViewItem Header="Child 1.1" AutomationProperties.AutomationId="tvChild11" AutomationProperties.Name="Child 1.1" />
                            <TreeViewItem Header="Child 1.2" AutomationProperties.AutomationId="tvChild12" AutomationProperties.Name="Child 1.2" />
                        </TreeViewItem>
                        <TreeViewItem Header="Root 2" AutomationProperties.AutomationId="tvRoot2" AutomationProperties.Name="Root 2">
                            <TreeViewItem Header="Child 2.1" AutomationProperties.AutomationId="tvChild21" AutomationProperties.Name="Child 2.1" />
                        </TreeViewItem>
                        <TreeViewItem Header="Root 3" AutomationProperties.AutomationId="tvRoot3" AutomationProperties.Name="Root 3" />
                    </TreeView>

                </StackPanel>
            </TabItem>

            <!-- Tab: Menu/Actions -->
            <TabItem Header="Menu/Actions"
                     AutomationProperties.AutomationId="tabMenuActions"
                     AutomationProperties.Name="Menu/Actions">
                <StackPanel Margin="8">

                    <!-- DataGrid (populated in code-behind) -->
                    <DataGrid x:Name="grdData"
                              AutomationProperties.AutomationId="grdData"
                              AutomationProperties.Name="grdData"
                              Height="80"
                              Margin="0,0,0,4"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name"   Binding="{Binding Name}"   Width="70" />
                            <DataGridTextColumn Header="Value"  Binding="{Binding Value}"  Width="60" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="70" />
                            <DataGridTextColumn Header="Id"     Binding="{Binding Id}"     Width="40" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Right-click target button with context menu -->
                    <Button x:Name="btnRightClickTarget"
                            AutomationProperties.AutomationId="btnRightClickTarget"
                            AutomationProperties.Name="Right-click me"
                            Content="Right-click me"
                            Height="32"
                            Margin="0,0,0,4">
                        <Button.ContextMenu>
                            <ContextMenu AutomationProperties.AutomationId="ctxRightClick">
                                <MenuItem x:Name="menuEdit"
                                          Header="Edit"
                                          AutomationProperties.AutomationId="menuEdit"
                                          AutomationProperties.Name="Edit" />
                                <MenuItem x:Name="menuDelete"
                                          Header="Delete"
                                          AutomationProperties.AutomationId="menuDelete"
                                          AutomationProperties.Name="Delete" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- Focus test buttons -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Button x:Name="btnFocusTarget1"
                                AutomationProperties.AutomationId="btnFocusTarget1"
                                AutomationProperties.Name="Focus Target 1"
                                Content="Focus 1"
                                Height="28"
                                Width="80"
                                Margin="0,0,8,0" />
                        <Button x:Name="btnFocusTarget2"
                                AutomationProperties.AutomationId="btnFocusTarget2"
                                AutomationProperties.Name="Focus Target 2"
                                Content="Focus 2"
                                Height="28"
                                Width="80" />
                    </StackPanel>

                </StackPanel>
            </TabItem>

        </TabControl>

    </StackPanel>
</Window>

<Window x:Class="Flawright.E2ETests.TestApp.OuterDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Outer Dialog"
        AutomationProperties.AutomationId="OuterDialogWindow"
        AutomationProperties.Name="Outer Dialog"
        Width="320"
        Height="160"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <StackPanel Margin="16" VerticalAlignment="Center">
        <TextBlock Text="This is the outer dialog." Margin="0,0,0,12" />

        <Button x:Name="btnOpenInner"
                Content="Open Inner Dialog"
                AutomationProperties.AutomationId="btnOpenInner"
                AutomationProperties.Name="Open Inner Dialog"
                Height="28"
                Click="BtnOpenInner_Click" />
    </StackPanel>
</Window>
